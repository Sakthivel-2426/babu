# ====================================================================
# BABU CINEMAS - BACKEND & ENVIRONMENT CONFIGURATION
# ====================================================================

# Express Server Port
PORT=5000

# --------------------------------------------------------------------
# 1. MONGODB DATABASE CONFIGURATION
# --------------------------------------------------------------------
# Local MongoDB format: mongodb://localhost:27017/babu-cinemas
# MongoDB Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/babu-cinemas?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/babu-cinemas"

# --------------------------------------------------------------------
# 2. JWT AUTHENTICATION
# --------------------------------------------------------------------
JWT_SECRET="babu_cinemas_jwt_super_secret_key_2026_secure"
JWT_EXPIRES_IN="7d"

# --------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (Optional for simulation/sandbox)
# --------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# Theatre UPI VPA for Dynamic QR generation & deep linking
THEATRE_UPI_ID="babucinemas@upi"
